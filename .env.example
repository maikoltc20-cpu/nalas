# GEMINI_API_KEY: Opcional (PRO deshabilitada; BÁSICA realiza 0 llamadas a IA).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública HTTPS del Worker en producción (sin barra final, ej. https://nalas-piloto.<subdominio>.workers.dev).
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Persistencia PostgreSQL (Neon Free - usar cadena "-pooler") + Autenticación
# Configurar con "npx wrangler secret put <NOMBRE>" (nunca pegar en código)
# ---------------------------------------------------------------------------
DATABASE_URL=""
NALAS_SESSION_SECRET=""
NALAS_DISABLE_DEMO_LOGIN="false"
NALAS_ADMIN_EMAIL=""
NALAS_ADMIN_PASSWORD=""
NALAS_INIT_SECRET=""

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Producción NEXO)
# Configurar únicamente desde Secrets / Variables del Worker
# ---------------------------------------------------------------------------
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_WHATSAPP_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_BUSINESS_ID="biz_nexo"
META_OUTBOUND_ENABLED="false"
